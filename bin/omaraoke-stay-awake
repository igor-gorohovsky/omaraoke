#!/usr/bin/env bash
# omaraoke-stay-awake — apply a mid-Session Stay Awake menu flip.
#
# on:  turn the shell's stay-awake flag on and record setStayAwake in
#      stash.json so omaraoke-restore clears it at close (unless the user
#      had it on before the Session).
# off: clear the flag only if the Session set it — never a user's own
#      stay-awake toggle — and record setStayAwake=false so restore
#      leaves it alone.
#
# No-op without an active Session (no stash.json); shares the state lock
# with omaraoke-stash/-restore.
set -euo pipefail

STATE_DIR="$HOME/.local/state/omaraoke"
STASH="$STATE_DIR/stash.json"
STAY_AWAKE_FLAG="$HOME/.local/state/omarchy/indicators/stay-awake"

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/.lock"
flock 9

[[ -s "$STASH" ]] || exit 0

case "${1:-}" in
  on)
    mkdir -p "$(dirname "$STAY_AWAKE_FLAG")"
    touch "$STAY_AWAKE_FLAG"
    jq '.setStayAwake = true' "$STASH" >"$STASH.tmp" && mv "$STASH.tmp" "$STASH"
    ;;
  off)
    if [[ $(jq -r '.setStayAwake // false' "$STASH") == "true" \
       && $(jq -r '.stayAwakeWasOn' "$STASH") != "true" ]]; then
      rm -f "$STAY_AWAKE_FLAG"
    fi
    jq '.setStayAwake = false' "$STASH" >"$STASH.tmp" && mv "$STASH.tmp" "$STASH"
    ;;
  *)
    echo "usage: omaraoke-stay-awake <on|off>" >&2
    exit 1
    ;;
esac
